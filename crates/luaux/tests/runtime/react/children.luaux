--!nocheck
local React = require("@pkg/@jsdotlua/react")
local ReactRoblox = require("@pkg/@jsdotlua/react-roblox")

local function mount(element)
	local container = Instance.new("Folder")
	ReactRoblox.createLegacyRoot(container):render(element)
	return container:GetChildren()[1]
end

return function(check)
	-- Children reach `props.children` as one table, which is what makes the
	-- single-argument form legal: createElement assigns a lone third argument
	-- straight through.
	local frame = mount(
		<Frame Name="Root">
			<TextLabel Name="a" />
			<TextLabel Name="b" />
		</Frame>
	)

	local names = {}
	for _, child in frame:GetChildren() do
		table.insert(names, child.Name)
	end
	table.sort(names)

	check("both children parented", #names == 2)
	check("children in the tree", names[1] == "a" and names[2] == "b")

	-- A fragment is an element here, not a plain table, and it must not add an
	-- Instance of its own.
	local flattened = mount(
		<Frame Name="Root">
			<>
				<TextLabel Name="x" />
				<TextLabel Name="y" />
			</>
			<TextLabel Name="z" />
		</Frame>
	)

	local flat = {}
	for _, child in flattened:GetChildren() do
		table.insert(flat, child.Name)
	end
	table.sort(flat)

	check("fragment adds no instance", #flat == 3)
	check("fragment children flattened", flat[1] == "x" and flat[2] == "y" and flat[3] == "z")

	-- A component goes through the factory under this arrangement, so it is
	-- interchangeable with an intrinsic at the call site.
	local function Row(props)
		return (<TextLabel Name={props.Name} Text="row" />)
	end

	local composed = mount(
		<Frame Name="Root">
			<Row Name="from-component" />
		</Frame>
	)

	local row = composed:GetChildren()[1]
	check("component invoked", row ~= nil and row.Name == "from-component")
	check("component props applied", row.Text == "row")
end
